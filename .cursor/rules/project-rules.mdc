### Form Components

```tsx
// ✅ CORRECT - Using React Hook Form with Zod
"use client";

import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import * as z from "zod";
import {
  Form,
  FormControl,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from "@/components/ui/form";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";

const loadSchema = z.object({
  customerRate: z.number().positive(),
  commodity: z.string().min(1, "Commodity is required"),
  // ... other fields
});

export function LoadForm() {
  const form = useForm<z.infer<typeof loadSchema>>({
    resolver: zodResolver(loadSchema),
  });

  const onSubmit = async (data: z.infer<typeof loadSchema>) => {
    // Handle submission
  };

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-6">
        <FormField
          control={form.control}
          name="commodity"
          render={({ field }) => (
            <FormItem>
              <FormLabel>Commodity</FormLabel>
              <FormControl>
                <Input {...field} />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />
        <Button type="submit">Create Load</Button>
      </form>
    </Form>
  );
}
```

## Database Rules

### Always Use Transactions

```typescript
// ✅ CORRECT - Use transactions for multi-table operations
async createLoadWithDocuments(loadData: any, documents: any[]) {
  return prisma.$transaction(async (tx) => {
    const load = await tx.load.create({ data: loadData });

    for (const doc of documents) {
      await tx.document.create({
        data: { ...doc, loadId: load.id }
      });
    }

    return load;
  });
}
```

### Multi-Tenant Queries

```typescript
// ✅ CORRECT - Always filter by organizationId
const loads = await prisma.load.findMany({
  where: {
    organizationId: req.auth.organizationId,
    status: "ACTIVE",
  },
});

// ❌ WRONG - Missing organizationId filter
