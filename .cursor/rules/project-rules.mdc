### API Patterns

#### Controllers (Thin Layer)

```typescript
// ✅ CORRECT - Controller only handles HTTP
export const createLoad = async (req: Request, res: Response) => {
  try {
    const { organizationId, userId } = req.auth;
    const load = await loadService.create(req.body, organizationId, userId);
    res.status(201).json({ success: true, data: load });
  } catch (error) {
    next(error);
  }
};

// ❌ WRONG - Business logic in controller
export const createLoad = async (req: Request, res: Response) => {
  // Don't put business logic here!
  const loadNumber = generateLoadNumber();
  const load = await prisma.load.create({...});
};
```

#### Services (Business Logic)

```typescript
// ✅ CORRECT - Service contains business logic
export class LoadService {
  async create(data: CreateLoadDto, orgId: string, userId: string) {
    // Validate business rules
    await this.validateLoadData(data);

    // Generate load number
    const loadNumber = await this.generateLoadNumber(orgId);

    // Create with repository
    const load = await this.loadRepo.create({
      ...data,
      loadNumber,
      organizationId: orgId,
      createdBy: userId,
    });

    // Side effects
    await this.notificationService.sendLoadCreated(load);

    return load;
  }
}
```

#### Repositories (Data Access)

```typescript
// ✅ CORRECT - Repository only handles data access
export class LoadRepository {
  async create(data: Prisma.LoadCreateInput) {
    return prisma.load.create({ data });
  }

  async findByOrganization(orgId: string, filters?: LoadFilters) {
    return prisma.load.findMany({
      where: {
        organizationId: orgId,
        ...filters,
      },
    });
  }
}
```

