## File Upload Handling

```typescript
// ✅ CORRECT - Environment-based storage
const storage =
  process.env.NODE_ENV === "production" ? s3Storage : localStorage;

const upload = multer({
  storage,
  limits: { fileSize: 10 * 1024 * 1024 }, // 10MB
  fileFilter: (req, file, cb) => {
    const allowed = [".pdf", ".jpg", ".png", ".doc", ".docx"];
    const ext = path.extname(file.originalname);
    cb(null, allowed.includes(ext));
  },
});
```

## Error Handling

### Global Error Handler

```typescript
// ✅ CORRECT - Centralized error handling
export class AppError extends Error {
  constructor(
    public message: string,
    public statusCode: number = 500,
    public code?: string
  ) {
    super(message);
  }
}

// In middleware
export const errorHandler = (err: Error, req, res, next) => {
  if (err instanceof AppError) {
    return res.status(err.statusCode).json({
      success: false,
      error: {
        code: err.code,
        message: err.message,
      },
    });
  }

  // Log unexpected errors
  logger.error(err);

  res.status(500).json({
    success: false,
    error: {
      code: "INTERNAL_ERROR",
      message: "Something went wrong",
    },
  });
};
```

