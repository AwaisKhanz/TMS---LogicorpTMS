# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tms

# Server
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-change-this
JWT_REFRESH_SECRET=your-refresh-token-secret-minimum-32-chars-change-this
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Storage (local or s3)
STORAGE_TYPE=local
PUBLIC_URL=http://localhost:4000/uploads

# AWS S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@logicorptms.com
SMTP_FROM_NAME=LogicorpTMS

# Email
FROM_EMAIL=noreply@logicorptms.com
FRONTEND_URL=http://localhost:3000

# DocuSign Configuration
# Get these from https://admindemo.docusign.com/ → Settings → Apps and Keys
DOCUSIGN_INTEGRATION_KEY=your-integration-key-here
DOCUSIGN_USER_ID=your-user-id-guid-here
DOCUSIGN_ACCOUNT_ID=your-account-id-here
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your-private-key-here
-----END RSA PRIVATE KEY-----"
# For demo/sandbox environment:
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com
# For production environment (after going live):
# DOCUSIGN_BASE_PATH=https://www.docusign.net/restapi
# DOCUSIGN_OAUTH_BASE_PATH=account.docusign.com
DOCUSIGN_WEBHOOK_SECRET=generate-random-secret-here

# Redis (optional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
