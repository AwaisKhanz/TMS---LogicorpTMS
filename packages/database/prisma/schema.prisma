// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ORGANIZATIONS ====================
model Organization {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logo    String?
  website String?

  // Company Details
  mcNumber  String @unique @default("MC000000")
  dotNumber String @default("DOT000000")
  address   Json   @default("{\"street\": \"\", \"city\": \"\", \"state\": \"\", \"zip\": \"\", \"country\": \"USA\"}") // { street, city, state, zip, country }

  // Settings
  settings          Json @default("{}")
  documentNumbering Json @default("{}")

  // Billing
  billingEmail  String?
  plan          String    @default("trial")
  planExpiresAt DateTime?

  // Status
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users     User[]
  loads     Load[]
  carriers  Carrier[]
  customers Customer[]
  shippers  Shipper[]
  consignees Consignee[]
  invoices  Invoice[]
  documents Document[]
  documentTemplates DocumentTemplate[]
  auditLogs AuditLog[]
  notifications Notification[]
  reports   Report[]
  reportSchedules ReportSchedule[]
  reportTemplates ReportTemplate[]
  payments  Payment[]

  @@map("organizations")
}

// ==================== USERS & AUTH ====================
model User {
  id             String @id @default(cuid())
  organizationId String
  email          String @unique
  passwordHash   String

  // Profile
  firstName String
  lastName  String
  phone     String?
  phoneVerified Boolean @default(false)
  avatar    String?

  // Auth
  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?

  // Status
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  organization       Organization        @relation(fields: [organizationId], references: [id])
  roles              UserRole[]
  customers          UserCustomer[]
  sessions           Session[]
  auditLogs          AuditLog[]
  createdLoads       Load[]              @relation("CreatedLoads")
  assignedLoads      Load[]              @relation("AssignedLoads")
  createdDocumentTemplates DocumentTemplate[] @relation("CreatedDocumentTemplates")
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  events             LoadEvent[]
  receivedNotifications Notification[]   @relation("ReceivedNotifications")
  reports            Report[]
  reportTemplates    ReportTemplate[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  permissions Permission[]
  users       UserRole[]
  isSystem    Boolean      @default(false)

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  resource    String
  action      String
  roles       Role[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserCustomer {
  userId     String
  customerId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([userId, customerId])
  @@map("user_customers")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([refreshToken])
  @@map("sessions")
}

// ==================== LOADS ====================
model Load {
  id              String     @id @default(cuid())
  organizationId  String
  loadNumber      String
  referenceNumber String?
  status          LoadStatus @default(QUOTE)

  // Customer & Carrier
  customerId String
  carrierId  String?
  driverName String?
  driverPhone String?
  truckNumber String?
  trailerNumber String?

  // Removed root-level pickup/delivery fields for many-to-many
  // Now handled in related LoadShipper and LoadConsignee
  internalNotes String?

  // Load Details
  commodity                    String
  weight                       Int
  pieces                       Int?
  units                        Int?
  multipleCommodityDescription String?
  dimensions                   Json?
  equipmentType                EquipmentType
  loadType                     LoadType @default(FULL_TRUCK)
  
  // Temperature (for REEFER equipment)
  minTemperature               Int?
  maxTemperature               Int?
  temperatureUnit              TemperatureUnit?
  continuousTemperature        Boolean @default(false)

  // Rates & Costs
  customerRate Decimal  @db.Money
  carrierRate  Decimal? @db.Money
  margin       Decimal? @db.Money
  // Financial adjustments (array of structured changes stored as JSON)
  financialAdjustments Json @default("[]")

  // Rate Change Tracking
  customerRateChangeReason String?
  carrierRateChangeReason  String?
  lastCustomerRateChange   DateTime?
  lastCarrierRateChange    DateTime?

  // Additional Costs
  accessorials Json @default("[]")

  // Tracking
  currentLocation Json?
  eta             DateTime?
  trackingMethod  String?

  // Status Timestamps
  bookedAt     DateTime?
  dispatchedAt DateTime?
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  invoicedAt   DateTime?
  paidAt       DateTime?

  // Metadata
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String
  assignedTo String?
  deletedAt  DateTime?

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id])
  customer     Customer         @relation(fields: [customerId], references: [id])
  carrier      Carrier?         @relation(fields: [carrierId], references: [id])
  creator      User             @relation("CreatedLoads", fields: [createdBy], references: [id])
  assignee     User?            @relation("AssignedLoads", fields: [assignedTo], references: [id])
  events       LoadEvent[]
  invoice      InvoiceLineItem?
  
  // New many-to-many relationships
  loadShippers   LoadShipper[]
  loadConsignees LoadConsignee[]
  
  // Note: Documents use polymorphic relationship - query with entityType='LOAD' and entityId

  @@unique([organizationId, loadNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, carrierId])
  @@index([organizationId, createdBy, status])
  @@map("loads")
}

model LoadEvent {
  id        String   @id @default(cuid())
  loadId    String
  eventType String
  eventData Json
  createdAt DateTime @default(now())
  createdBy String?

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("load_events")
}

// ==================== LOAD SHIPPERS & CONSIGNEES ====================
model LoadShipper {
  id        String @id @default(cuid())
  loadId    String
  shipperId String
  
  // Additional fields for load-shipper relationship
  isPrimary     Boolean @default(false)
  sequence      Int     @default(1) // Order of pickup
  pickupDate    DateTime?
  pickupStart   String?
  pickupEnd     String?
  pickupType    String  @default("FCFS")
  pickupNotes   String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  load    Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  shipper Shipper @relation(fields: [shipperId], references: [id], onDelete: Cascade)
  
  @@unique([loadId, shipperId])
  @@index([loadId])
  @@index([shipperId])
  @@map("load_shippers")
}

model LoadConsignee {
  id          String @id @default(cuid())
  loadId      String
  consigneeId String
  
  // Additional fields for load-consignee relationship
  isPrimary      Boolean @default(false)
  sequence       Int     @default(1) // Order of delivery
  deliveryDate   DateTime?
  deliveryStart  String?
  deliveryEnd    String?
  deliveryType   String  @default("FCFS")
  deliveryNotes  String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  load      Load      @relation(fields: [loadId], references: [id], onDelete: Cascade)
  consignee Consignee @relation(fields: [consigneeId], references: [id], onDelete: Cascade)
  
  @@unique([loadId, consigneeId])
  @@index([loadId])
  @@index([consigneeId])
  @@map("load_consignees")
}

// ==================== CARRIERS ====================
model Carrier {
  id             String @id @default(cuid())
  organizationId String

  // Identification
  mcNumber  String
  dotNumber String?
  scac      String?

  // Company Info
  companyName String
  dba         String?
  ein         String?

  // Contact
  email   String
  phone   String
  fax     String?
  address Json

  // Primary Contact
  contactName  String
  contactPhone String
  contactEmail String

  // Compliance
  authorityStatus    String    @default("ACTIVE")
  insuranceExpiry    DateTime?
  insuranceAmount    Decimal?  @db.Money
  cargoInsurance     Decimal?  @db.Money
  liabilityInsurance Decimal?  @db.Money

  // Safety
  safetyRating String?
  csa          Json?

  // Financial
  paymentTerms     String  @default("NET30")
  paymentMethod    String  @default("CHECK")
  w9OnFile         Boolean @default(false)
  factoring        Boolean @default(false)
  factoringCompany String?

  // Performance
  totalLoads     Int   @default(0)

  // Preferences
  preferredLanes Json     @default("[]")
  equipment      String[] @default([])

  // Status
  isActive   Boolean   @default(true)
  isApproved Boolean   @default(false)
  approvedAt DateTime?
  approvedBy String?
  notes      String?

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id])
  loads        Load[]
  contacts     CarrierContact[]
  invoices     Invoice[]
  // Note: Documents use polymorphic relationship - query with entityType='CARRIER' and entityId

  @@unique([organizationId, mcNumber])
  @@index([organizationId, isActive])
  @@index([organizationId, companyName])
  @@index([organizationId, isActive, isApproved])
  @@index([organizationId, mcNumber, isActive])
  @@map("carriers")
}

model CarrierContact {
  id        String  @id @default(cuid())
  carrierId String
  name      String
  title     String?
  email     String
  phone     String
  isPrimary Boolean @default(false)

  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@index([carrierId])
  @@map("carrier_contacts")
}

// ==================== CUSTOMERS ====================
model Customer {
  id             String @id @default(cuid())
  organizationId String

  // Company Info
  companyName String
  dba         String?
  industry    String?
  website     String?
  ein         String?

  // Billing
  billingAddress Json
  billingEmail   String
  billingPhone   String

  // Credit
  creditLimit  Decimal @default(0) @db.Money
  creditUsed   Decimal @default(0) @db.Money
  paymentTerms String  @default("NET30")

  // Stats
  totalRevenue  Decimal @default(0) @db.Money
  totalLoads    Int     @default(0)
  averageMargin Float   @default(0)

  // Preferences
  equipmentTypes    String[] @default([])

  // Status
  isActive Boolean @default(true)
  notes    String?

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  organization Organization      @relation(fields: [organizationId], references: [id])
  loads        Load[]
  invoices     Invoice[]
  contacts     CustomerContact[]
  users        UserCustomer[]
  // Note: Documents use polymorphic relationship - query with entityType='CUSTOMER' and entityId

  @@unique([organizationId, companyName])
  @@index([organizationId, isActive])
  @@index([organizationId, companyName, isActive])
  @@index([organizationId, billingEmail])
  @@map("customers")
}

model CustomerContact {
  id         String  @id @default(cuid())
  customerId String
  name       String
  title      String?
  email      String
  phone      String
  isPrimary  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

// ==================== INVOICES ====================
model Invoice {
  id             String @id @default(cuid())
  organizationId String
  invoiceNumber  String
  customerId     String
  carrierId      String?

  // Dates
  invoiceDate DateTime @default(now())
  dueDate     DateTime

  // Amounts
  total    Decimal @db.Money

  // Payment
  status           InvoiceStatus @default(DRAFT)
  paidAmount       Decimal       @default(0) @db.Money

  // Email Tracking (minimal)
  sentAt         DateTime?

  // Metadata
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relations
  organization Organization      @relation(fields: [organizationId], references: [id])
  customer     Customer          @relation(fields: [customerId], references: [id])
  carrier      Carrier?          @relation(fields: [carrierId], references: [id])
  lineItems    InvoiceLineItem[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, status, invoiceDate])
  @@index([organizationId, dueDate, status])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  loadId      String? @unique
  description String
  quantity    Int     @default(1)
  rate        Decimal @db.Money
  amount      Decimal @db.Money

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  load    Load?   @relation(fields: [loadId], references: [id])

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ==================== PAYMENTS ====================
enum PaymentType {
  CUSTOMER
  CARRIER
}

enum PaymentMethod {
  CASH
  CHECK
  ACH
  WIRE
  CREDIT_CARD
  OTHER
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  type           PaymentType
  amount         Decimal       @db.Money
  method         PaymentMethod
  date           DateTime      @default(now())
  reference      String?
  notes          String?
  createdAt      DateTime      @default(now())
  createdBy      String

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, invoiceId, type])
  @@index([organizationId, date])
  @@map("payments")
}

// ==================== DOCUMENTS ====================
model Document {
  id             String @id @default(cuid())
  organizationId String

  // Reference (Polymorphic relationship - handled at application level)
  entityType EntityType
  entityId   String

  // Document Info
  type     DocumentType
  name     String
  fileUrl  String
  fileSize Int
  mimeType String

  // Metadata
  uploadedAt DateTime  @default(now())
  uploadedBy String
  expiresAt  DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  // Note: entityId is a polymorphic reference, no foreign key constraints
  // Application will handle joins based on entityType + entityId

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, type])
  @@index([organizationId, uploadedAt])
  @@index([organizationId, expiresAt])
  @@map("documents")
}

model DocumentTemplate {
  id             String      @id @default(cuid())
  organizationId String
  type           DocumentType
  name           String
  template       String      // HTML template content
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation("CreatedDocumentTemplates", fields: [createdBy], references: [id])

  @@unique([organizationId, type, name])
  @@index([organizationId, type])
  @@index([organizationId, isDefault])
  @@map("document_templates")
}

// ==================== AUDIT LOGS ====================
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String
  entityType     String
  entityId       String
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== ENUMS ====================
enum LoadStatus {
  QUOTE
  BOOKED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  POD_RECEIVED
  COMPLETED
  PAID
  CANCELLED
}

enum LoadType {
  FULL_TRUCK
  LTL
  PARTIAL
  EXPEDITED
}

enum EquipmentType {
  DRY_VAN
  REEFER
  FLATBED
  STEP_DECK
  RGN
  POWER_ONLY
  HOTSHOT
  BOX_TRUCK
  STRAIGHT_TRUCK
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  PARTIAL
  OVERDUE
  VOID
}

enum EntityType {
  LOAD
  CARRIER
  CUSTOMER
  DOCUMENT
  INVOICE
  PAYMENT
  VIEWER
  ORGANIZATION
  REPORT
}

enum TemperatureUnit {
  FAHRENHEIT
  CELSIUS
}

enum DocumentType {
  RATE_CONFIRMATION
  BOL
  POD
  INVOICE
  W9
  INSURANCE
  AUTHORITY
  CONTRACT
  AVATAR
  OTHER
}

// ==================== PASSWORD RESET ====================
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("password_resets")
}

// ==================== EMAIL VERIFICATION ====================
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("email_verifications")
}


// ==================== SHIPPERS & CONSIGNEES ====================
model Shipper {
  id             String @id @default(cuid())
  organizationId String

  // Company Information
  companyName    String
  phone          String
  email          String?

  // Address Information (JSON format: { street, city, state, zip, country, formattedAddress?, latitude?, longitude?, placeId? })
  address Json @default("{\"street\": \"\", \"city\": \"\", \"state\": \"\", \"zip\": \"\", \"country\": \"USA\"}")

  // Additional Information
  contactPerson  String?
  notes          String?

  // Status
  isActive       Boolean @default(true)

  // Metadata
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  loadShippers   LoadShipper[]

  @@unique([organizationId, companyName])
  @@index([organizationId, isActive])
  @@index([organizationId, companyName])
  @@map("shippers")
}

model Consignee {
  id             String @id @default(cuid())
  organizationId String

  // Company Information
  companyName    String
  phone          String
  email          String?

  // Address Information (JSON format: { street, city, state, zip, country, formattedAddress?, latitude?, longitude?, placeId? })
  address Json @default("{\"street\": \"\", \"city\": \"\", \"state\": \"\", \"zip\": \"\", \"country\": \"USA\"}")

  // Additional Information
  contactPerson  String?
  notes          String?

  // Status
  isActive       Boolean @default(true)

  // Metadata
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  loadConsignees LoadConsignee[]

  @@unique([organizationId, companyName])
  @@index([organizationId, isActive])
  @@index([organizationId, companyName])
  @@map("consignees")
}

// ==================== REPORTS ====================
enum ReportType {
  LOAD_ANALYTICS
  CARRIER_PERFORMANCE
  CUSTOMER_ANALYTICS
  REVENUE_ANALYSIS
  OPERATIONAL_METRICS
  TEAM_PERFORMANCE
  FINANCIAL_SUMMARY
  CUSTOM
}

enum ReportStatus {
  DRAFT
  GENERATED
  SCHEDULED
  FAILED
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
  JSON
}

enum TimeRange {
  TODAY
  YESTERDAY
  THIS_WEEK
  LAST_WEEK
  THIS_MONTH
  LAST_MONTH
  THIS_QUARTER
  LAST_QUARTER
  THIS_YEAR
  LAST_YEAR
  CUSTOM
}

model Report {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  
  // Report Details
  name           String
  description    String?
  type           ReportType
  status         ReportStatus @default(DRAFT)
  format         ReportFormat @default(PDF)
  timeRange      TimeRange
  customDateFrom DateTime?
  customDateTo   DateTime?
  parameters     Json       @default("{}")
  
  // File Information
  fileUrl        String?
  fileSize       Int?
  generatedAt    DateTime?
  generatedBy    String?
  
  // Sharing
  isPublic       Boolean   @default(false)
  sharedWith     String[]  @default([])
  tags           String[]  @default([])
  
  // Scheduling
  scheduledAt    DateTime?
  lastGeneratedAt DateTime?
  nextGenerationAt DateTime?
  
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  schedule       ReportSchedule?
  templateId     String?
  template       ReportTemplate? @relation(fields: [templateId], references: [id])
  
  @@index([organizationId, userId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("reports")
}

model ReportSchedule {
  id             String   @id @default(cuid())
  reportId       String   @unique
  organizationId String
  
  // Schedule Details
  frequency      String   // DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY
  dayOfWeek      Int?     // 0-6 (Sunday-Saturday)
  dayOfMonth     Int?     // 1-31
  time           String   // HH:MM format
  timezone       String   @default("UTC")
  
  // Recipients
  recipients     String[] // Array of email addresses
  
  // Status
  isActive       Boolean  @default(true)
  
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  @@index([organizationId, isActive])
  @@map("report_schedules")
}

model ReportTemplate {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  
  // Template Details
  name           String
  description    String?
  type           ReportType
  format         ReportFormat
  timeRange      TimeRange
  parameters     Json     @default("{}")
  
  // Template Content
  template       Json     // Template configuration/structure
  
  // Status
  isActive       Boolean  @default(true)
  isPublic       Boolean  @default(false)
  
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  reports        Report[]
  
  @@index([organizationId, type])
  @@index([organizationId, isActive])
  @@map("report_templates")
}

// ==================== NOTIFICATIONS ====================
enum NotificationType {
  LOAD_STATUS_CHANGE
  LOAD_ASSIGNED
  DOCUMENT_GENERATED
  INVOICE_CREATED
  PAYMENT_RECEIVED
  CARRIER_CREATED
  CARRIER_UPDATED
  CARRIER_APPROVED
  CARRIER_SUSPENDED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  SYSTEM_ALERT
  REPORT_GENERATED
  REPORT_FAILED
  REPORT_SCHEDULED
}


model Notification {
  id             String   @id @default(cuid())
  organizationId String
  recipientId    String
  
  // Content
  type           NotificationType
  title          String
  message        String
  
  // Optional link to entity
  entityType     EntityType?
  entityId       String?
  
  // Status (simple)
  isRead         Boolean  @default(false)
  readAt         DateTime?
  
  // Timestamps
  createdAt      DateTime @default(now())
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  recipient      User         @relation("ReceivedNotifications", fields: [recipientId], references: [id])
  
  @@index([organizationId, recipientId, isRead])
  @@index([recipientId, createdAt])
  @@map("notifications")
}




